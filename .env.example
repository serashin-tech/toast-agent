# 이 파일을 작업 폴더의 .env 로 복사해 값을 채웁니다. .env 는 메일, 시트, 현황판, 결과 파일, 로그에 쓰지 않습니다.
# 공공데이터포털 인증키(Decoding 또는 Encoding 키 어느 쪽이든 됩니다)
DATA_GO_KR_SERVICE_KEY=
# 한콘진 지원사업공고 요청 주소(활용신청 후 확인해서 채웁니다)
KOCCA_API_URL=
# 수집 이력 시트에 붙인 Apps Script 웹 앱 주소와 토큰(apps-script/README.md)
SHEET_APP_URL=
SHEET_APP_TOKEN=
# 신규 알림 메일에 넣을 수집 이력 시트 주소(대표만 받는 메일에만 들어갑니다)
SHEET_URL=
